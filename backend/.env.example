SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
# Storage access for NASA data, map tiles, calibration and local context.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

GOOGLE_PLACES_API_KEY=your_google_places_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_key_here
OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here

# Required for /tiles/prefill; without it prefill is switched off.
PREFILL_TOKEN=choose_a_long_random_string

# Sign-in check (meili_auth.py). Leave both empty to keep it off.
# Use the Supabase project the app signs users in with.
AUTH_SUPABASE_URL=
AUTH_SUPABASE_ANON_KEY=

# Local news context and AI area summaries (local_context_gatherer.py, tools/summarise_areas.py).
TAVILY_API_KEY=
MEILI_AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional tuning and proxy settings; defaults live in the code.
# MEILI_CONTEXT_MODEL=  MEILI_CONTEXT_FALLBACK_MODEL=  MEILI_SUMMARY_MODEL=
# MEILI_PREGATHER_MAX_AREAS=  MEILI_REFRESH_AFTER_DAYS=  MEILI_STORAGE_BUDGET_MB=
# MEILI_PROXY_URL=  MEILI_PROXY_SECRET=  MEILI_SOCIAL_CONTEXT_DATA=  OLLAMA_URL=
